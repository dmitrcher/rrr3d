# Preserve shipped Motor Rock data byte-for-byte. Its original text files use
# CRLF and trailing spaces that must not be normalized or treated as source
# whitespace errors.
resources/game-data/** -text -diff -whitespace

# This is a patch payload; lines beginning with a single space are significant
# unified-diff context, not project source formatting.
cmake/patches/*.patch -text -diff -whitespace

# Experimental patch payloads preserve the SDK's exact context and whitespace.
tools/calibration/experimental/*.patch -text -whitespace

# Third-party license text is preserved verbatim.
resources/macos/Licenses/** -text -diff -whitespace

# VCBuild 2008 solution parser requires the original CRLF layout.
tools/editor/*.sln -text whitespace=cr-at-eol
tools/editor/*.cmd -text whitespace=cr-at-eol

# Keep VC2008 command scripts in CRLF form.
tools/calibration/*.cmd -text whitespace=cr-at-eol

# Keep the checksum-verified v38 vendor geometry snapshot byte-for-byte.
tools/calibration/experimental/native-plane-normal-v38/src/Rock3dEngine/header/physics/SourceMeshManifold.h -text -whitespace

# Keep checksum-verified v39 geometry snapshots byte-for-byte.
tools/calibration/experimental/native-depth-v39/src/Rock3dEngine/header/physics/SourceMeshManifold.h -text -whitespace
tools/calibration/experimental/native-depth-v39/before/SourceMeshManifold.h -text -whitespace

# Preserve checksum-verified experimental v40 before/after source snapshots.
tools/calibration/experimental/native-cache-frame-v40/before/** -text -whitespace
tools/calibration/experimental/native-cache-frame-v40/src/** -text -whitespace
tools/calibration/experimental/motor-runtime-v40/*.cmd -text whitespace=cr-at-eol
