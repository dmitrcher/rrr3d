if(NOT DEFINED SOURCE_DIR)
    message(FATAL_ERROR "SOURCE_DIR is required")
endif()
file(READ "${SOURCE_DIR}/Jolt/Physics/Collision/ContactListener.h" _source)
string(FIND "${_source}" "source-solved-contact support" _patched)
if(NOT _patched EQUAL -1)
    return()
endif()
execute_process(COMMAND patch -p1 -i "${CMAKE_CURRENT_LIST_DIR}/patches/jolt-source-contact-impulses.patch"
    WORKING_DIRECTORY "${SOURCE_DIR}" RESULT_VARIABLE _result)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Could not apply pinned Jolt solved-contact patch")
endif()
