+			{
+				Vec3 tangent1, tangent2;
+				constraint.GetTangents(tangent1, tangent2);
+				friction_impulse -= tangent1 * wcp.mFrictionConstraint1.GetTotalLambda() + tangent2 * wcp.mFrictionConstraint2.GetTotalLambda();
