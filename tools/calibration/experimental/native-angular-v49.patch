+void Body::AddNativeRotationStep(Vec3Arg inAngularVelocity, float inDeltaTime)
+{
+ JPH_ASSERT(IsRigidBody());
+ JPH_ASSERT(BodyAccess::sCheckRights(BodyAccess::sPositionAccess(), BodyAccess::EAccess::ReadWrite));
+ if (inAngularVelocity.IsNearZero(0.0f)) return;
+ const std::array<float, 4> sourceRotation = {-mRotation.GetX(), -mRotation.GetZ(), -mRotation.GetY(), mRotation.GetW()};
+ const std::array<float, 3> sourceVelocity = {-inAngularVelocity.GetX(), -inAngularVelocity.GetZ(), -inAngularVelocity.GetY()};
+ const auto step = ::motorrock::nativeangular::integrate(sourceRotation, sourceVelocity, inDeltaTime);
+ mRotation = Quat(-step.rotation[0], -step.rotation[2], -step.rotation[1], step.rotation[3]);
+ JPH_ASSERT(!mRotation.IsNaN());
+}
