#!/bin/zsh
set -euo pipefail
motorrock_root="${0:A:h}"
for motorrock_key in ${(k)parameters}; do
  if [[ "$motorrock_key" == RRR3D_* || "$motorrock_key" == NX_* ]]; then unset "$motorrock_key"; fi
done
export RRR3D_SEED='42'
export NX_SPRING_ITERATIONS='4'
export RRR3D_EXPERIMENT_UPPER_FACE_WINDING='1'
export RRR3D_EXPERIMENT_NEGATIVE_X_FACE_ORDER='1'
export RRR3D_EXPERIMENT_PRINCIPAL_MOMENTUM='1'
export RRR3D_EXPERIMENT_FROZEN_INITIAL_NORMALIZE='1'
export RRR3D_EXPERIMENT_SPRING_BIAS='1'
export RRR3D_EXPERIMENT_SPRING_FINAL='1'
export RRR3D_EXPERIMENT_SPRING_LOST='1'
export RRR3D_EXPERIMENT_SPRING_COLD='1'
export RRR3D_EXPERIMENT_FRICTION_ZERO='1'
export RRR3D_EXPERIMENT_SUSPENSION_STOP='1'
export RRR3D_EXPERIMENT_MESH_CONTACTS='1'
export RRR3D_EXPERIMENT_TIRE_FORCE_HISTORY='1'
export RRR3D_EXPERIMENT_SUSPENSION_RAW='1'
export RRR3D_EXPERIMENT_MATERIAL_FRAME_CANDIDATE='1'
export RRR3D_EXPERIMENT_NATIVE_CONTACT_MASS='1'
export RRR3D_EXPERIMENT_NATIVE_CONTACT_BIAS='1'
export RRR3D_EXPERIMENT_NATIVE_CONTACT_POINT_VELOCITY='1'
export RRR3D_EXPERIMENT_NATIVE_CONTACT_ORIGINAL_DELTA='1'
export RRR3D_EXPERIMENT_NATIVE_CONTACT_FORCE_FIRST='1'
export RRR3D_EXPERIMENT_NATIVE_CONTACT_ERROR_FRAME='1'
export RRR3D_EXPERIMENT_NATIVE_MESH_EDGE='1'
export RRR3D_EXPERIMENT_NATIVE_CONTACT_CACHE='1'
export RRR3D_EXPERIMENT_NATIVE_MATERIAL_FRAME='1'
export RRR3D_EXPERIMENT_NATIVE_CONTACT_INERTIA='1'
export RRR3D_EXPERIMENT_NATIVE_TRIANGLE_PLANE='1'
export RRR3D_EXPERIMENT_NATIVE_SOLVER_NORMAL='1'
export RRR3D_EXPERIMENT_NATIVE_POLYGON_DEPTH='1'
export RRR3D_EXPERIMENT_NATIVE_CACHE_FRAME='1'
export RRR3D_EXPERIMENT_NATIVE_SOLVER_INERTIA='1'
export RRR3D_EXPERIMENT_NATIVE_CACHE_POSE='1'
export RRR3D_EXPERIMENT_NATIVE_GEOMETRY_POSE='1'
export RRR3D_EXPERIMENT_NATIVE_FROZEN_CM_RESTORE='1'
export RRR3D_EXPERIMENT_NATIVE_CALLBACK_TRIANGLE_NORMAL='1'
export RRR3D_EXPERIMENT_NATIVE_POSITIVE_Z_FACE_ORDER='1'
export RRR3D_EXPERIMENT_NATIVE_INITIAL_COM='1'
export RRR3D_EXPERIMENT_NATIVE_ACTOR_ORIGIN='1'
export RRR3D_EXPERIMENT_NATIVE_ACTOR_OUTPUT='1'
export RRR3D_EXPERIMENT_NATIVE_SHAPE_TRANSLATION='1'
export RRR3D_EXPERIMENT_NATIVE_MASS_DOT_ORDER='1'
export RRR3D_EXPERIMENT_NATIVE_FROZEN_CM_EXACT='1'
export RRR3D_EXPERIMENT_NATIVE_PRINCIPAL_INERTIA='1'
export RRR3D_EXPERIMENT_NATIVE_SHAPE_MASS='1'
export RRR3D_EXPERIMENT_NATIVE_ANGULAR_INTEGRATION='1'
export RRR3D_EXPERIMENT_NATIVE_PUBLIC_ANGULAR_MOMENTUM='1'
export RRR3D_EXPERIMENT_NATIVE_DYNAMIC_ACTOR_OUTPUT='1'
export RRR3D_EXPERIMENT_NATIVE_EXACT_SHAPE_COM='1'
export RRR3D_EXPERIMENT_NATIVE_SINGLE_AXIS_FRICTION='1'
export RRR3D_EXPERIMENT_NATIVE_SOLVER_FRAME_MULTIPLY='1'
export RRR3D_EXPERIMENT_NATIVE_CACHE_LOCAL_POINT_ORDER='1'
export RRR3D_EXPERIMENT_NATIVE_CACHE_LEVER_ORDER='1'
export RRR3D_EXPERIMENT_NATIVE_CALLBACK_ACTOR_ROTATION='1'
export RRR3D_EXPERIMENT_NATIVE_NONUNIT_POSE_MATRIX='1'
export RRR3D_EXPERIMENT_NATIVE_WHEEL_RAY_ORIGIN='1'
export RRR3D_EXPERIMENT_NATIVE_WHEEL_TRIANGLE_POINT='1'
export RRR3D_EXPERIMENT_NATIVE_SPRING_SPLIT_V53='1'
export RRR3D_EXPERIMENT_NATIVE_SPRING_PREP_V53='1'
export RRR3D_EXPERIMENT_NATIVE_WHEEL_SHAPE_POSE_V54='1'
