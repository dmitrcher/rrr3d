export RRR3D_EXPERIMENT_NATIVE_TIRE_REVERSE_V55='1'
export RRR3D_EXPERIMENT_NATIVE_TIRE_REPORT_V56='1'
export RRR3D_EXPERIMENT_NATIVE_WHEEL_ROW_FRAME_V57='1'
export RRR3D_EXPERIMENT_NATIVE_TIRE_COLD_V57='1'
export RRR3D_EXPERIMENT_NATIVE_WHEEL_ANCHOR_BIAS_V57='1'
export RRR3D_EXPERIMENT_NATIVE_TIRE_VELOCITY_LIMIT_V58='1'
export RRR3D_EXPERIMENT_NATIVE_LOST_LOCAL_FRAME_V58='1'
export RRR3D_EXPERIMENT_NATIVE_LOST_TIRES_V59='1'
export RRR3D_EXPERIMENT_NATIVE_WHEEL_BOX_QUERY_V59='1'
export RRR3D_CALIBRATION_PROFILE="${motorrock_root}/windows-source-v14.cfg"
motorrock_log="${HOME}/Library/Logs/RRR3d/research-v59-$(date +%Y%m%d-%H%M%S)"
mkdir -p "${motorrock_log}/screenshots"
export RRR3D_TRACE_FILE="${motorrock_log}/trace.jsonl"
export RRR3D_CAPTURE_DIR="${motorrock_log}/screenshots"
export RRR3D_AI_DRIVER=0
print -r -- "Исследовательская физика v59. Логи: ${motorrock_log}"
exec "${motorrock_root}/RRR3d.app/Contents/MacOS/RRR3d" --legacy-windows-debug "$@"
